# ==============================================================================
# Sepsis Monitor AI - Environment Configuration Template (.env.example)
# Local Development | Offline-Safe Defaults
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Cryptographic Application Configuration
# ------------------------------------------------------------------------------
# Local development placeholder only.
SECRET_KEY=REPLACE_WITH_A_UNIQUE_SECRET_KEY

# ------------------------------------------------------------------------------
# 3. Clinical Role Authentication - SHA-256
# ------------------------------------------------------------------------------
# Each variable must contain the 64-character hexadecimal SHA-256 digest
# of the corresponding access token.
#
# NOTE: Pre-calculated demo hashes and their corresponding plaintext tokens
# (e.g., 'nicu_secure_2026', 'nicu_nurse_2026') are documented inside README.md
# for immediate Recruiter and Hiring Team evaluation.
#
# Never store plaintext access tokens or production digests in this template.

SEF_SECTIE_HASH=REPLACE_WITH_SHA256_HEX_DIGEST
MEDIC_ECHIPA_HASH=REPLACE_WITH_SHA256_HEX_DIGEST
MEDIC_GARDA_HASH=REPLACE_WITH_SHA256_HEX_DIGEST
REZIDENT_HASH=REPLACE_WITH_SHA256_HEX_DIGEST
ASISTENT_HASH=REPLACE_WITH_SHA256_HEX_DIGEST

# ------------------------------------------------------------------------------
# 4. Database
# ------------------------------------------------------------------------------
# Local SQLite database destination.
DATABASE_URL=sqlite:///sepsis_neonatal.db

# ------------------------------------------------------------------------------
# 5. LLM / Groq Integration
# ------------------------------------------------------------------------------
# Offline-safe local simulation defaults.
# Configure a valid provider API key only when external LLM access is intended.
GROQ_MODEL_NAME=llama-3.1-8b-instant
GROQ_API_KEY=OFFLINE_SIMULATION_ACTIVE
LLM_API_BASE_URL=http://localhost:8501

# ==============================================================================
# SECURITY NOTES
# ==============================================================================
# 1. Copy this template to .env for local configuration.
# 2. Keep .env excluded from version control (.gitignore).
# 3. Replace all placeholders before enabling authentication or production use.
# 4. SHA-256 is used here for token-digest verification, not password storage.
# 5. For human passwords, use a password-hashing algorithm such as Argon2id.
# 6. Validate configuration at startup; fail closed if required credentials
#    are missing, malformed, or still set to placeholders.
# 7. Never commit API keys, production secrets, real access tokens, or real
#    clinical communication credentials.
